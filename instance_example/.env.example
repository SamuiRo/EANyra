# EANyra environment variables
# Created as <project>/.env by npm run instance:init.
# Never commit a real token or credential to this template.

# General
NODE_ENV=production

# Runtime paths
# Relative paths are resolved from INSTANCE_DIR (default: <project>/instance).
# Select another instance in this root .env or via the process environment.
INSTANCE_DIR=instance
DATA_DIR=data
ACCOUNTS_CONFIG_PATH=accounts.json
CONTEXT_DIR=context
EXPORTS_DIR=data/exports

# Scheduler
# Standard 5-field cron expression, evaluated in UTC.
CRON_SCHEDULE="0 8 * * *"
RUN_ON_STARTUP=false

# Encrypted credentials vault (npm run nyra -- vault init)
# All logins and tokens live in VAULT_PATH, encrypted with your master password.
# The token/session variables further below are only a legacy fallback and are
# imported (and can be blanked) by `npm run nyra -- vault migrate --purge`.
VAULT_PATH=secrets.vault
# Background unlock: prefer `npm run nyra -- vault remember` (Windows DPAPI).
# EANYRA_MASTER_PASSWORD is supported but stores the password in plaintext.
# EANYRA_MASTER_PASSWORD=

# SQLite
DB_PATH=data/pot.sqlite
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
# How long a connection waits for a concurrent writer before SQLITE_BUSY.
DB_BUSY_TIMEOUT_MS=5000

# Local web UI (npm run serve). Loopback only.
WEB_HOST=127.0.0.1
WEB_PORT=3030

# MCP server
# MCP_TRANSPORT: stdio | http
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=3001
MCP_ROUTE=/mcp
MCP_HEALTH_ROUTE=/health
MCP_EXPORT_MAX_CHARS=80000
MCP_QUERY_MAX_RECORDS=100
MCP_DEFAULT_POST_LIMIT=20
MCP_DEFAULT_SIGNAL_LIMIT=30
MCP_DEFAULT_STATS_DAYS=30
MCP_DEFAULT_STATUS_HISTORY=5
MCP_MAX_STATUS_HISTORY=20

# Browser / Playwright
# Legacy plaintext X profile and cookie cache; only read by `vault migrate` and
# in legacy mode without a vault. X sessions now live in the vault.
BROWSER_DATA_PATH=data/nyra
BROWSER_COOKIES_PATH=data/cookies.json
# Default file for `npm run import-cookies` when no path is passed.
BROWSER_COOKIES_IMPORT_PATH=data/imports/cookies.json
BROWSER_HEADLESS=true
BROWSER_NAV_TIMEOUT_MS=30000
BROWSER_SEL_TIMEOUT_MS=15000
BROWSER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/134.0.0.0 Safari/537.36"
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=900
BROWSER_LOCALE=en-US
BROWSER_TIMEZONE=America/New_York
# Preferred installed browser for interactive login. Leave empty to use
# Playwright's bundled Chromium.
BROWSER_LOGIN_CHANNEL=chrome

# Twitter / X
TWITTER_BASE_URL=https://x.com
TWITTER_LOGIN_URL=https://x.com/i/flow/login
TWITTER_HOME_URL=https://x.com/home

# Scraper behavior
POSTS_PER_ACCOUNT=20
INITIAL_POSTS_PER_ACCOUNT=200
SCROLL_DELAY_MS=2500
MIN_DELAY_BETWEEN_ACCOUNTS_MS=300000
MAX_DELAY_BETWEEN_ACCOUNTS_MS=900000
# Pause when switching between different X logins (sessions).
MIN_DELAY_BETWEEN_SESSIONS_MS=30000
MAX_DELAY_BETWEEN_SESSIONS_MS=120000
MAX_SCROLL_ATTEMPTS=30
# Stop early when this many consecutive scrolls load no new post IDs.
MAX_STAGNANT_SCROLL_ATTEMPTS=4
# Open known root tweets to discover thread parts omitted from profile timelines.
MAX_TWITTER_CONVERSATION_ROOTS=10
MAX_TWITTER_CONVERSATION_SCROLLS=2
SCRAPER_NAV_TIMEOUT_MS=30000
SCRAPER_SELECTOR_TIMEOUT_MS=15000
SCRAPER_WAKE_UP_MAX_MS=180000

# Markdown export
EXPORT_DEFAULT_DAYS=7
EXPORT_MAX_RECORDS=100

# GitHub
# Store tokens with `npm run nyra -- secrets set github [session]`.
# Fine-grained tokens need read access to repository contents and metadata.
# Legacy plaintext fallback for the "default" session:
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
GITHUB_USER_AGENT=eanyra/1.7.1
GITHUB_LOOKBACK_DAYS=8
GITHUB_REPOS_PER_ACCOUNT=30
GITHUB_RELEASES_PER_REPO=10
GITHUB_COMMITS_PER_REPO=100
GITHUB_COMMIT_MESSAGES_PER_BATCH=10

# LinkedIn CSV import
LINKEDIN_IMPORTS_DIR=data/imports
LINKEDIN_SHARES_FILE=Shares.csv
LINKEDIN_PROFILE_FILE=Profile.csv

# Telegram publishing (bot) and polling (MTProto)
TELEGRAM_PUBLISH_TRANSPORT=bot
# Store secrets in the vault instead:
#   npm run nyra -- secrets set telegram-bot [bot-name]   (token from @BotFather)
#   npm run nyra -- secrets set telegram-api               (my.telegram.org/apps)
#   npm run login:telegram [-- --session name]             (QR login)
# The values below are a legacy plaintext fallback for the "default" session.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_FETCH_LIMIT=100
TELEGRAM_INITIAL_POSTS_PER_ACCOUNT=20
TELEGRAM_MAX_PAGES_PER_ACCOUNT=20
TELEGRAM_OVERLAP_MINUTES=60
TELEGRAM_CONNECTION_RETRIES=5
