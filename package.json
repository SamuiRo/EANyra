{
  "name": "eanyra",
  "version": "4.1.2",
  "description": "Local AI-assisted social media workspace: collects your own accounts (X, Telegram, LinkedIn, GitHub) into SQLite, plans and drafts posts with personas, and serves it all through MCP and a local web UI.",
  "main": "src/core/cli/index.js",
  "bin": {
    "eanyra": "src/core/cli/index.js"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "postinstall": "playwright install chromium",
    "start": "node src/core/cli/index.js start",
    "nyra": "node src/core/cli/index.js",
    "dev": "node --watch src/core/cli/index.js start",
    "serve": "node src/core/cli/index.js serve",
    "scrape": "node src/core/cli/index.js scrape",
    "scrape:twitter": "node src/core/cli/index.js scrape twitter",
    "scrape:github": "node src/core/cli/index.js scrape github",
    "scrape:linkedin": "node src/core/cli/index.js scrape linkedin",
    "scrape:telegram": "node src/core/cli/index.js scrape telegram",
    "context:sync": "node src/core/cli/index.js context sync",
    "export": "node src/core/cli/index.js export",
    "export:dry": "node src/core/cli/index.js export --no-mark",
    "login": "node src/core/cli/login.js",
    "login:telegram": "node src/core/cli/telegram-login.js",
    "import-cookies": "node src/core/cli/import-cookies.js",
    "test": "node --test",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "mcp": "node src/core/mcp/start.js",
    "instance:init": "node src/core/instance/cli.js init",
    "instance:migrate": "node src/core/instance/cli.js migrate",
    "instance:restore": "node src/core/instance/cli.js restore",
    "instance:protect": "node src/core/instance/cli.js protect",
    "backup": "node src/core/cli/index.js backup"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamuiRo/EANyra.git"
  },
  "keywords": [
    "mcp",
    "ai",
    "social-media",
    "content",
    "twitter",
    "telegram",
    "linkedin",
    "github",
    "sqlite",
    "playwright"
  ],
  "author": "StarLith",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/SamuiRo/EANyra/issues"
  },
  "homepage": "https://github.com/SamuiRo/EANyra#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chalk": "^5.3.0",
    "commander": "^14.0.3",
    "dotenv": "^16.4.5",
    "gradient-string": "^2.0.2",
    "node-cron": "^4.6.0",
    "playwright": "^1.44.1",
    "qrcode": "1.5.4",
    "sequelize": "^6.37.3",
    "sqlite3": "^6.0.1",
    "telegram": "^2.26.22",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "sequelize-cli": "^6.6.2"
  }
}
